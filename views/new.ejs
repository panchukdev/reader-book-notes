<%- include("partials/header.ejs") %>

<main>
  <div class="new-container">
    <div class="new-book-container">
      <div class="new-book-header">
        <h1>New Book</h1>
        <% if (typeof error !== "undefined") { %>
        <p><%= error %></p>
        <% } else { %>
          <p>Add a book to your library</p>
          <% } %>
      </div>
  <form class="new-book-form" action="/new" method="post" >
    <div>
      <label for="title">Title</label>
      <input type="text" name="title" placeholder="Rich Dad Poor Dad">
    </div>
    
    <div>
      <label for="author">Author</label>
      <input type="text" name="author" placeholder="Robert Kiyosaki">
    </div>
    
    <div>
      <label for="started">When did you start reading this book?</label>
      <input type="date" name="started" id="started"
      value="<%= new Date().toISOString().split('T')[0] %>"
      >
    </div>

    <div class="pages-container">
      <label for="read_pages">How many pages have you read?</label>
      <div class="pages-inputs">
        <input type="number" name="read_pages" id="read_pages" value="0" min="0">
        <p>out of</p>
        <input type="number" name="pages" id="pages" min="0" placeholder="300">
      </div>
    </div>
    
    <div>
      <label for="">Notes</label>
      <textarea name="notes" id="notes" placeholder="Key ideas, thoughts, quotes..."></textarea>
    </div>
    
    <div class="new-book-button">
      <button type="submit">Add Book</button>
    </div>
  </form>
  </div>
  </div>
</main>
<footer>Made by panchukdev in 2026</footer>

<%- include("partials/footer.ejs") %>
